# Hybrid Probabilistic-Generative Cascade Environment Template
# Copy to .env and populate valid credentials if running live API calls.

# System-1 Probabilistic Prior Engine
TYPESAFE_API_KEY=your_typesafe_api_key_here

# System-2 Frontier Reasoning Model
OPENAI_API_KEY=your_openai_api_key_here

# System-2 Cost-Efficient Reasoning Model
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Alpaca Market Data & News API (Free Tier)
APCA_API_KEY_ID=your_alpaca_key_id_here
APCA_API_SECRET_KEY=your_alpaca_secret_key_here

# Streaming Sandbox Read-Only Telemetry Auth Token
TELEMETRY_BEARER_TOKEN=change_me_telemetry_bearer_token

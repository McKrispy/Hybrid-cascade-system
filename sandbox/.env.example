# HybridCascade Streaming Financial Sandbox Environment Variables
# Copy to .env and fill in valid credentials before running.

# System-1 Fast Prior Model (Mandatory)
TYPESAFE_API_KEY=your_typesafe_api_key_here

# System-2 Escalator Model A (Mandatory, non-US/non-HK IP recommended)
OPENAI_API_KEY=your_openai_api_key_here

# System-2 Escalator Model B (Mandatory)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Primary Market Data & News Provider (Mandatory Free Tier)
# Standard Alpaca SDK variable names
APCA_API_KEY_ID=your_alpaca_key_id_here
APCA_API_SECRET_KEY=your_alpaca_secret_key_here

# Read-only Telemetry REST Server Auth Token (Port 8090)
TELEMETRY_BEARER_TOKEN=change_me_telemetry_bearer_token

